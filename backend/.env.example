# Inspo AI Studio - Backend Environment Variables
# Copy this file to .env and fill in your credentials

# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Supabase (Database, Auth & Realtime Collaboration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Core AI Providers (at least one recommended)
OPENAI_API_KEY=sk-proj-your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Cloudinary (Image & Moodboard Asset Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Firebase Admin SDK (for token verification)
FIREBASE_CLIENT_EMAIL=your_firebase_admin_email@iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

