# Inspo AI Studio - Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (default for local development)
VITE_API_URL=http://localhost:5001

# Google Fonts API Key (for typography and font preview search)
VITE_GOOGLE_FONTS_API_KEY=your_google_fonts_api_key

# Pollinations AI / Image Generation (Optional)
VITE_POLLINATIONS_API_KEY=your_pollinations_api_key

# Local Access / Development Bypass Password
VITE_LEGACY_PASSWORD=inspoai-dev
